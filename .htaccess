# ==========================================================================
# $ROBIN — Apache config for shared hosting (InMotion, cPanel, most others).
# Drop this in the same folder as index.html. Safe to delete if your host
# is not Apache — nothing here is required for the site to work.
# ==========================================================================

# --- keep the API key out of the browser --------------------------------
# api/config.php holds your key. PHP never serves its source, but a
# misconfigured host can. Deny it outright, along with dotfiles.
<FilesMatch "^(config\.php|config\.example\.php|\.env.*|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve the source of a proxy as plain text, whatever the extension.
<IfModule mod_headers.c>
  <FilesMatch "\.(php)$">
    Header unset X-Powered-By
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # This page opens the user's own wallet extension and talks to public APIs.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --- correct types ------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/svg+xml              .svg
  AddType application/json           .json
  AddType text/javascript            .js
</IfModule>

# --- compression --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Images and video are already compressed; recompressing wastes CPU.
</IfModule>

# --- caching ------------------------------------------------------------
# Long cache on artwork, short on code so edits go live quickly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType image/webp           "access plus 1 year"
  ExpiresByType image/gif            "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 year"
  ExpiresByType image/x-icon         "access plus 1 year"
  ExpiresByType text/css             "access plus 1 hour"
  ExpiresByType text/javascript      "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# --- https --------------------------------------------------------------
# Uncomment once your SSL certificate is active in cPanel.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- tidy ---------------------------------------------------------------
Options -Indexes
